{
  "workspace": ["./client", "./server"],
  "tasks": {
    "dev": "deno task --cwd server dev",
    "build": "deno task --cwd server build",
    "check": "deno task --members check && deno lint && deno fmt --check"
  },
  "nodeModulesDir": "auto",
  "unstable": ["bundle"],
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@kuboon/*"]
  },
  "imports": {
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@^0.21.0",
    "@remix-run/render-middleware": "npm:@remix-run/render-middleware@^0.2.0",
    "@remix-run/ui": "npm:@remix-run/ui@^0.8.0",
    "@kuboon/remix-assets-deno": "jsr:@kuboon/remix-assets-deno@^0.5.0",
    "@kuboon/remix-ssg": "jsr:@kuboon/remix-ssg@^0.8.0",
    "@kuboon/md": "jsr:@kuboon/md@^0.3.0",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9"
  },
  "fmt": {
    "exclude": ["dist", "node_modules"]
  },
  "lint": {
    "exclude": ["dist", "node_modules"]
  }
}
